{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "postUpgradeTasks": {
    "commands": [
      "./gradlew -Dorg.gradle.caching=false -Dorg.gradle.configureondemand=false -Dorg.gradle.parallel=false dependencies --write-verification-metadata pgp,sha256 --refresh-keys --export-keys --write-locks"
    ],
    "fileFilters": [
      "gradle/verification-metadata.xml",
      "gradle/verification-keyring.gpg",
      "gradle/verification-keyring.keys"
    ],
    "installTools": {
      "java": {}
    }
  }
}
